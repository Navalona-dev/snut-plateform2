{% extends 'supervisorBase.html.twig' %}

{% block title %}Superviseur central- PVRD visualisation{% endblock %}

{% block body %}

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Procès - Verbal de Récéption Définitive (PVRD)</h1>
    <p class="mb-4">Vous êtes sur la page dédiée à la visualisation des PVRD par région. Vous y trouverez le nombre de districts dans chaque région, les PVRD reçus de ces districts.</p>
    
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Liste des PVRD par région</h6>
            <form method="post" action="{{ path('app_accueil_sp_pvrd') }}">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label for="" class="mb-2">Année</label>
                        <select name="anne_liste" id="anne_liste" class="form-control form-control-sm chosen-select">
                            <option value="">Selectionner année</option>
                            {% for anne in dataAnneePrevisionnelle %}
                            <option value="{{anne.IdAnneePrevisionnelle}}">{{anne.Annee}}</option>
                            {% endfor %} 
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                
                    <div class="form-group mb-3">
                        <label for="" class="mb-2">Commande</label>
                        <select name="commande_liste" id="commande_liste" class="form-control form-control-sm chosen-select">
                            <option value="">Selectionner commande</option>
                            {% for commande in dataCommandeTrimestrielle %}

                            <option value="{{commande.idCommandeTrimestrielle}}" {% if commande.idCommandeTrimestrielle == currentCommande.id %} selected ="selected" {% endif %}>{{commande.nomCommande}}</option>
                                
                            {% endfor %} 
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                     <label for="" class="mb-2">&nbsp;</label>
                    <div class="form-group mb-3">
                        <button type="submit" class="btn btn-success">Valider</button>
                    </div>
                </div> 
            </div>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive table-wrapper"> 
                <table class="table table-bordered table-fixed-header" id="dataTablePvrd" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="textTblCenterBoldPink">N°</th> 
                            <th class="textTblCenterBoldPink">Région</th>
                            <th class="textTblCenterBoldPink">Chef lieu</th>
                            <th class="textTblCenterBoldPink">Nombre des districts</th>
                            <th class="textTblCenterBoldPink">Nombre des PVRD reçu</th> 
                        </tr> 
                    </thead>
                    <tfoot>
                        <tr>
                            <th class="textTblCenterBoldPink">N°</th> 
                            <th class="textTblCenterBoldPink">Région</th>
                            <th class="textTblCenterBoldPink">Chef lieu</th>
                            <th class="textTblCenterBoldPink">Nombre des districts</th>
                            <th class="textTblCenterBoldPink">Nombre des PVRD reçu</th> 
                        </tr> 
                    </tfoot>
                    <tbody>
                        {% set increment = 1 %}
                        {% for region in lstRegionPvrd %}
                            <tr>
                                <td>{{ increment }}</td>
                                <td class="titleTblLeftrBoldBlue">
                                    <a href="{{ path('app_sp_pvrd_region_commande', {'regionId': region.regionId, 'commandeId': currentCommande.id}) }}"> 
                                        {{ region.regionNom }} 
                                    </a> 
                                </td>
                                <td>{{ region.regionChefLieu }}</td>
                                <td class="titleTblCenterBoldBlue">{{ region.nombreDeDistricts }}</td>
                                {% if (region.nombrePvrds > 0) %}
                                    <td class="titleTblCenterBoldGreen">
                                        <span class="badge bg-success badge-pill" style="font-size: 14px; color: #FFF">
                                            {{ region.nombrePvrds }}
                                        </span>
                                    </td>
                                    {% else %}
                                    <td class="titleTblCenterBoldGreen">
                                        <span class="badge bg-danger badge-pill" style="font-size: 14px; color: #FFF">
                                            {{ region.nombrePvrds }}
                                        </span>
                                    </td>
                                {% endif %}
                                {% set increment = increment +1 %} 
                            </tr>
                        {% endfor %}
                    </tbody>
                </table> 
            </div>
        </div>
    </div>

</div> 
{% endblock %}