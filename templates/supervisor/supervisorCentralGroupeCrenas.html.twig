{% extends 'supervisorBase.html.twig' %}

{% block title %}Superviseur central- Groupe CRENAS{% endblock %}

{% block body %}

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">CRENAS</h1>
    <p class="mb-4">Vous êtes actuellement sur la page consacrée à la visualisation des CRENAS répartis par groupe. Vous y trouverez une liste des provinces regroupées, permettant de consulter les informations concernant les bons de commande reçus des districts affiliés à chaque groupe.</p>
    
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Liste des groupes</h6>
          
             <form method="post" action="{{ path('app_accueil_sp_rmanut') }}">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label for="" class="mb-2">Année</label>
                        <select name="anne_liste" id="anne_liste" class="form-control form-control-sm chosen-select" onChange = "return getAllGroupeByYear(this.value)">
                            <option value="">Selectionner année</option>
                            {% for anne in dataAnneePrevisionnelle %}
                            <option value="{{anne.IdAnneePrevisionnelle}}">{{anne.Annee}}</option>
                            {% endfor %} 
                        </select>
                    </div>
                </div>
                {# <div class="col-md-4">
                
                    <div class="form-group mb-3">
                        <label for="" class="mb-2">Commande</label>
                        <select name="commande_liste" id="commande_liste" class="form-control form-control-sm chosen-select">
                            <option value="">Selectionner commande</option>
                            {% for commande in dataCommandeTrimestrielle %}

                            <option value="{{commande.idCommandeTrimestrielle}}" {% if commande.idCommandeTrimestrielle == currentCommande.id %} selected ="selected" {% endif %}>{{commande.nomCommande}}</option>
                                
                            {% endfor %} 
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                     <label for="" class="mb-2">&nbsp;</label>
                    <div class="form-group mb-3">
                        <button type="submit" class="btn btn-success">Valider</button>
                    </div>
                </div>  #}
            </div>
            </form>
        </div>
        <div id="groupeByYear">
            <div class="card-body">
            <div class="table-responsive table-wrapper"> 
                <table class="table table-bordered table-fixed-header" id="dataTableGroupeCrenas" width="100%" cellspacing="0">
                    <thead>
                        <tr> 
                            <th class="textTblCenterBoldPink">Groupe</th>
                            <th class="textTblCenterBoldPink">Provinces</th> 
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th class="textTblCenterBoldPink">Groupe</th>
                            <th class="textTblCenterBoldPink">Provinces</th>
                        </tr> 
                    </tfoot>
                    <tbody>
                        {% for key, groupe in lstGroupData %}
                            <tr>
                                <td class="titleTblCenterBoldGreen">{{ key }}</td>
                                <td>
                                    <ul class="no-decoration">
                                        {% for element in groupe %}
                                            {# <li><a href="{{ path('app_accueil_sp_crenas_in_groupe', {'groupId': element.idGroupe}) }}">{{ element.provinceNomFR }}</a></li> #}
                                            <li><a href="{{ path('app_accueil_sp_crenas_in_groupe', {'groupId': element.idGroupe}) }}">{{ element.provinces }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        </div>
        
    </div> 

</div>
<script>
function getAllGroupeByYear(annee = null) {
            $.ajax({
                url: '/supervisor/groupe/ajax',
                type: 'POST',
                data: {annee: annee},
                success: function (response) {
                    $("#groupeByYear").empty();
                    $("#groupeByYear").append(response.html);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // Gérer l'erreur (par exemple, afficher un message d'erreur)
                    alert('Erreur lors de l\'ajout de la produit catégorie.');
                }
            });
    }
</script>
{% endblock %}
